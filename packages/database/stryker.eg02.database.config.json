{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/eg02.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.eg02.mutation.config.ts", "related": false },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/repositories/api-cost-estimation.ts",
    "src/repositories/official-balance-states.ts"
  ],
  "thresholds": { "high": 100, "low": 80, "break": 80 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

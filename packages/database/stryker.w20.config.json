{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/w20-department-evidence.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.w20.mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": ["src/repositories/department-cost-evidence.ts:232:1-236:2"],
  "thresholds": { "high": 100, "low": 80, "break": 80 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/pool043.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.pool043.mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/repositories/operating-bill-account-aggregate.ts",
    "src/repositories/operating-bill-cost-quality.ts",
    "src/repositories/operating-bill-month.ts",
    "src/repositories/operating-bill-concurrency.ts",
    "src/repositories/operating-bill-write-barrier.ts",
    "src/repositories/gateway-ledger-settlement.ts",
    "src/repositories/gateway-ledger-settlement-assertions.ts",
    "src/repositories/gateway-ledger-guarded-writes.ts"
  ],
  "thresholds": { "high": 100, "low": 80, "break": 70 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/pool029.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.pool029.mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": ["src/repositories/employee-model-authorization-policy.ts"],
  "thresholds": { "high": 100, "low": 80, "break": 70 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

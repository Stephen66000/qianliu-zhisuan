# 仟流智算开发环境变量样例
# 依据：工程规则 §5（配置与密钥）、TRD §17（环境变量名冻结）。
# 本文件只写变量名和假值，不写真实 Secret。复制为 .env 后填入本机或测试值；.env 不进 Git。

# === 上游 Provider 凭证（TRD §17 冻结变量名；只从进程环境或 Secret Manager 注入）===
DEEPSEEK_API_KEY=sk-deepseek-PLACEHOLDER-DO-NOT-USE
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_CODING_TOKEN=zhipu-PLACEHOLDER-DO-NOT-USE
ZHIPU_CODING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
KIMI_CODING_TOKEN=kimi-PLACEHOLDER-DO-NOT-USE
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/v1

# === 官网计价截图识别（专用系统主体 Key，不得复用管理员/员工 Key）===
RULE_EXTRACTION_GATEWAY_BASE_URL=https://gw.qianliuai.com/v1
RULE_EXTRACTION_GATEWAY_API_KEY=
RULE_EXTRACTION_MODELS=ql-k3,ql-glm-5.3-flash

# === 服务端 Pepper / HMAC / KEK / Cookie（不与摘要/密文同库存储；工程规则 §5 / TRD §5.3 §5.4 §14.3）===
GATEWAY_KEY_PEPPER=dev-only-pepper-REPLACE-IN-PILOT
SESSION_AFFINITY_HMAC_KEY=dev-only-affinity-key-REPLACE-IN-PILOT
# 上游凭证信封加密密钥（32 字节 base64）；试点前由部署 Secret 注入
CREDENTIAL_KEK=dev-only-kek-REPLACE-IN-PILOT-32bytes-base64
# Cookie 会话签名密钥（control-api requireEnv 强制，F-02 缺则启动失败）；生产用 openssl rand -base64 32
COOKIE_SECRET=dev-only-cookie-secret-REPLACE-IN-PILOT

# === PostgreSQL（本地 Compose 默认值；端口 5433 避免与本机已有 PG 冲突）===
POSTGRES_DB=qianliu
POSTGRES_USER=qianliu
POSTGRES_PASSWORD=qianliu_dev_only
DATABASE_URL=postgres://qianliu:qianliu_dev_only@127.0.0.1:5433/qianliu

# === Redis（本地 Compose 默认值；端口 6380 避免冲突；纯内存派生状态）===
REDIS_URL=redis://127.0.0.1:6380

# === 应用配置 ===
CONTENT_RETENTION_MODE=METADATA_ONLY # TRD §14.3：当前版本固定 METADATA_ONLY，不得改值
LOG_LEVEL=info
NODE_ENV=development
# 管理后台精确 Origin（协议+主机+端口，不含路径）；多个值用逗号分隔。生产环境必填。
WEB_ORIGIN=http://127.0.0.1:8080
# === 运行保障（RA-W01；平台级观察/执行开关，不用于日常厂商规则管理）===
RUNTIME_ASSURANCE_MODE=OBSERVE # OFF|OBSERVE|ENFORCE；安全默认 OBSERVE
RUNTIME_ASSURANCE_WECOM_NOTIFY=false # 仅正式熔断/恢复消息；第一版按成员 userid 定向发送
RUNTIME_ASSURANCE_ADMIN_URL= # 可选；用于企微事件详情链接，必须是成员可访问的 http(s) 后台根地址
RUNTIME_ASSURANCE_INTERVAL_MS=30000 # Worker 扫描周期，最小 1000ms
WORKER_HEALTH_PORT=9191 # 仅 Worker 容器内健康检查

# === 2.0 新增页面／API／Worker（回退时逐项改 false，不影响 Gateway 和 1.0 页面）===
FEATURE_DIRECTORY_IMPORT=false
FEATURE_USAGE_OVERVIEW_V2=false
FEATURE_DEPARTMENT_COST=false
FEATURE_RESOURCE_UTILIZATION_V2=false
FEATURE_PROCUREMENT_REVIEW=false

# === Gateway 上游流式超时（POOL-014 / POOL-030 / POOL-034）===
GATEWAY_UPSTREAM_FIRST_BYTE_TIMEOUT_MS=30000
GATEWAY_KIMI_FIRST_BYTE_TIMEOUT_MS=120000
# 可选精细覆盖：GATEWAY_{DEEPSEEK|ZHIPU|KIMI}_{API|CODING_PLAN}_FIRST_BYTE_TIMEOUT_MS
# 流式空闲超时：全局默认 45 秒；智谱 Coding Plan 未配置时独立放宽到 120 秒（GLM-5.2 长推理块间静默），其他厂商回退 45 秒。
GATEWAY_UPSTREAM_STREAM_IDLE_TIMEOUT_MS=45000
# 可选精细覆盖：GATEWAY_{DEEPSEEK|ZHIPU|KIMI}_{API|CODING_PLAN}_STREAM_IDLE_TIMEOUT_MS
GATEWAY_UPSTREAM_REQUEST_TIMEOUT_MS=600000

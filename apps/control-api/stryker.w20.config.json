{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/w20-contracts.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.w20.mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/directory/excel.ts:31:1-46:2",
    "src/department-costs/contracts.ts:47:1-59:2"
  ],
  "thresholds": { "high": 80, "low": 70, "break": 70 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

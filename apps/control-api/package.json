{
  "name": "@qianliu/control-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:integration": "vitest run --config ../../vitest.config.ts src/__tests-integration__",
    "test:e2e": "echo 'control-api e2e deferred to M1' && exit 0",
    "seed:admin": "tsx src/cli/seed-admin.ts",
    "seed:e2e": "tsx src/cli/seed-e2e.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.0.1",
    "@fastify/csrf-protection": "7.1.0",
    "@opentelemetry/api": "1.9.0",
    "@qianliu/config": "workspace:*",
    "@qianliu/contracts": "workspace:*",
    "@qianliu/database": "workspace:*",
    "@qianliu/domain": "workspace:*",
    "@qianliu/observability": "workspace:*",
    "@qianliu/provider-adapters": "workspace:*",
    "argon2": "0.41.1",
    "decimal.js": "10.6.0",
    "fastify": "5.8.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@qianliu/testing": "workspace:*",
    "@types/node": "22.10.10",
    "kysely": "0.28.7",
    "tsx": "4.19.2"
  }
}

{
  "name": "@qianliu/control-api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:integration": "vitest run --config ../../vitest.config.ts --dir src/__tests-integration__",
    "test:e2e": "echo 'control-api e2e deferred to M1' && exit 0"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@opentelemetry/api": "1.9.0",
    "@qianliu/config": "workspace:*",
    "@qianliu/contracts": "workspace:*",
    "@qianliu/database": "workspace:*",
    "@qianliu/domain": "workspace:*",
    "@qianliu/observability": "workspace:*",
    "decimal.js": "10.6.0",
    "fastify": "5.6.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "tsx": "4.19.2"
  }
}

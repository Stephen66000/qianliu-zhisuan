{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/pool040.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.pool040.mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/pipeline/revoked-attempt-settlement.ts"
  ],
  "thresholds": { "high": 80, "low": 80, "break": 80 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

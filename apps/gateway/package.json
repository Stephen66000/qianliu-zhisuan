{
  "name": "@qianliu/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:integration": "vitest run --config ../../vitest.config.ts src/__tests-integration__",
    "test:e2e": "tsx src/cli/run-codex-e2e.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@qianliu/config": "workspace:*",
    "@qianliu/contracts": "workspace:*",
    "@qianliu/database": "workspace:*",
    "@qianliu/domain": "workspace:*",
    "@qianliu/observability": "workspace:*",
    "@qianliu/provider-adapters": "workspace:*",
    "fastify": "5.8.5",
    "undici": "7.29.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@qianliu/testing": "workspace:*",
    "@types/node": "22.20.1",
    "kysely": "0.28.17",
    "tsx": "4.19.2"
  }
}

{
  "name": "@qianliu/worker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:integration": "echo 'worker integration deferred' && exit 0",
    "test:e2e": "echo 'worker e2e deferred' && exit 0"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@qianliu/config": "workspace:*",
    "@qianliu/database": "workspace:*",
    "@qianliu/observability": "workspace:*",
    "decimal.js": "10.6.0",
    "redis": "5.8.2",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "tsx": "4.19.2"
  }
}

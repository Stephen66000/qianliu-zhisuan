         WHERE enterprise_id=(target).enterprise_id AND ai_request_id=(target).ai_request_id
           AND api_cost_status='PRICED_USAGE'
        UNION ALL
        SELECT actual_cost AS amount FROM dispatch_decision
         WHERE enterprise_id=(target).enterprise_id AND ai_request_id=(target).ai_request_id

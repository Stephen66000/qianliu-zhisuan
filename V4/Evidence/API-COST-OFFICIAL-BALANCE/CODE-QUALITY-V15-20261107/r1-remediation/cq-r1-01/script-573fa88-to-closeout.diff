+# 清单完整性门：不过＝drop_shadow_or_die（删影子、exit $1）。
+# $1=exit 码（replay=6；verify/swap 内联=8）；$2=拒绝动作词（回放/校验）。
+require_manifest_integrity() {
+  MANIFEST_STATE=0
+  manifest_integrity_state || MANIFEST_STATE=$?

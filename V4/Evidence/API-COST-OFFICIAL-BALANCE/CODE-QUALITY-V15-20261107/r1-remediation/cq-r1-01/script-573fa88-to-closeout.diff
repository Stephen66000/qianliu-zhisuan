+    1) drop_shadow_or_die "$1" "清单无 manifest_done 完成标记（export 未成功）——拒绝$2" "$DB_SHADOW";;
+    2) drop_shadow_or_die "$1" "清单 sha256 不符（被篡改/截断）——拒绝$2" "$DB_SHADOW";;
+  esac
+}

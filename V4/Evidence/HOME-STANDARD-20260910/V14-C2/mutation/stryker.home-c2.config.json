{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/home-c2.json" },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.home-c2-mutation.config.ts" },
  "coverageAnalysis": "perTest",
  "mutate": ["src/repositories/dashboard-home-metrics.ts:24-44"],
  "thresholds": { "high": 100, "low": 90, "break": 80 },
  "timeoutMS": 60000,
  "concurrency": 2,
  "disableTypeChecks": true,
  "cleanTempDir": true
}

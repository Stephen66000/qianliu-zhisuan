# 仟流智算 2.0 标准目标环境入口。
# QIANLIU_PUBLIC_HOST 仅填写域名，例如 zhisuan.example.com；Caddy 自动申请并续期 TLS 证书。

{$QIANLIU_PUBLIC_HOST} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy gateway:8787 {
			flush_interval -1
		}
	}

	handle /gateway-health {
		rewrite * /health
		reverse_proxy gateway:8787
	}

	handle_path /api/* {
		reverse_proxy control-api:8788
	}

	handle {
		reverse_proxy web:80
	}
}

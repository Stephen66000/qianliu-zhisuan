# 标准目标环境配置模板。复制为 deploy/.env 后替换全部 PLACEHOLDER；本文件不存真实 Secret。
QIANLIU_PUBLIC_HOST=zhisuan.example.com
WEB_ORIGIN=https://zhisuan.example.com
NODE_ENV=production
LOG_LEVEL=info
CONTENT_RETENTION_MODE=METADATA_ONLY

POSTGRES_DB=qianliu
POSTGRES_USER=qianliu
POSTGRES_PASSWORD=PLACEHOLDER_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgres://qianliu:PLACEHOLDER_STRONG_DATABASE_PASSWORD@postgres:5432/qianliu
REDIS_URL=redis://redis:6379

DEEPSEEK_API_KEY=PLACEHOLDER_RESOURCE_OWNER_SECRET
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_CODING_TOKEN=PLACEHOLDER_RESOURCE_OWNER_SECRET
ZHIPU_CODING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
KIMI_CODING_TOKEN=PLACEHOLDER_RESOURCE_OWNER_SECRET
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/v1

GATEWAY_KEY_PEPPER=PLACEHOLDER_GENERATE_BASE64_32
SESSION_AFFINITY_HMAC_KEY=PLACEHOLDER_GENERATE_BASE64_32
CREDENTIAL_KEK=PLACEHOLDER_GENERATE_BASE64_32
COOKIE_SECRET=PLACEHOLDER_GENERATE_BASE64_32

FEATURE_DIRECTORY_IMPORT=true
FEATURE_USAGE_OVERVIEW_V2=true
FEATURE_DEPARTMENT_COST=true
FEATURE_RESOURCE_UTILIZATION_V2=true
FEATURE_PROCUREMENT_REVIEW=true

RUNTIME_ASSURANCE_MODE=OBSERVE
RUNTIME_ASSURANCE_WECOM_NOTIFY=false
RUNTIME_ASSURANCE_INTERVAL_MS=30000
WORKER_HEALTH_PORT=9191
# 每轮分别消费至多 200 个小时 dirty 桶和 200 个自然日 dirty 桶；允许 1..1000。
USAGE_AGGREGATE_DIRTY_LIMIT=200

# 企业微信团队全员周报指定接收人（支持姓名如 "李佳" 或 企微UserID，多个用逗号隔开）
WECOM_COMPANY_REPORT_RECIPIENTS=李佳

